<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Tailcalls>false</Tailcalls>
    <RootNamespace>Ranvier.Keyboard.Dom</RootNamespace>
    <AssemblyName>Ranvier.Keyboard.Dom</AssemblyName>
    <PackageId>Fable.Ranvier.Keyboard.Dom</PackageId>
    <PackageId Condition="'$(RanvierTrace)' == 'true'">Fable.Ranvier.Keyboard.Dom.Traced</PackageId>
    <Title>Fable.Ranvier.Keyboard.Dom</Title>
    <Description>Fable (fickl) browser DOM adapter bridging Ranvier.Dom.KeyboardEvent (from Fable.Ranvier.Dom) to Ranvier.Keyboard with zero-cost StringEnum physical key reads and lazy AltGraph modifier queries. Use in browser fickl apps; use Ranvier.Keyboard.Dom on native .NET / Ranvier.View.WebCore hosts, or Ranvier.Keyboard alone when no DOM dependency is needed.</Description>
    <Description Condition="'$(RanvierTrace)' == 'true'">The traced build of Fable.Ranvier.Keyboard.Dom: Fable browser Ranvier.Dom.KeyboardEvent adapter for Ranvier.Keyboard. Depends on Ranvier.Keyboard.Traced and Fable.Ranvier.Dom.Traced.</Description>
    <PackageTags>keyboard;dom;events;keychord;fable;w3c;ranvier;fsharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <RanvierAotClean>true</RanvierAotClean>
    <RanvierExactSiblingVersions>true</RanvierExactSiblingVersions>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarnOn>$(WarnOn);3390</WarnOn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Ranvier.Keyboard.Dom/KeyboardEvent.fs" Link="KeyboardEvent.fs" />
    <None Include="../../LICENSE" Pack="true" PackagePath="licenses/Ranvier.Keyboard/" />
    <None Include="../Ranvier.Keyboard.Dom/README.md" Pack="true" PackagePath="/" />
    <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="/" Visible="false" />
    <ProjectReference Include="../Ranvier.Keyboard/Ranvier.Keyboard.fsproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRanvier)' == 'true'">
    <ProjectReference Include="$(RanvierRoot)/src/Fable.Ranvier.Dom/Fable.Ranvier.Dom.fsproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRanvier)' != 'true'">
    <PackageReference Include="Fable.Ranvier.Dom$(RanvierPackageSuffix)" Version="$(RanvierDomVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
    <AssemblyMetadata Include="RanvierTrace" Value="true" />
  </ItemGroup>
  <Target Name="PackageSharedKeyboardEvent" AfterTargets="CreateStandaloneFableProject">
    <ItemGroup>
      <_PackageFiles Update="@(_PackageFiles)" Condition="'%(_PackageFiles.Extension)' == '.fs'">
        <PackagePath>fable/%(_PackageFiles.Filename)%(_PackageFiles.Extension)</PackagePath>
      </_PackageFiles>
    </ItemGroup>
    <WriteLinesToFile File="$(NuspecOutputPath)fable/$(MSBuildProjectFile)" Overwrite="true" Lines="&lt;Project Sdk=&quot;Microsoft.NET.Sdk&quot;&gt;;  &lt;PropertyGroup&gt;;    &lt;TargetFramework&gt;netstandard2.1&lt;/TargetFramework&gt;;    &lt;AssemblyName&gt;Ranvier.Keyboard.Dom&lt;/AssemblyName&gt;;  &lt;/PropertyGroup&gt;;  &lt;ItemGroup&gt;;    &lt;Compile Include=&quot;KeyboardEvent.fs&quot; /&gt;;  &lt;/ItemGroup&gt;;&lt;/Project&gt;" />
  </Target>
</Project>