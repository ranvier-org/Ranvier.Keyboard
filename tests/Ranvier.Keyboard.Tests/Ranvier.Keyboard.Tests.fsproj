<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="IsoAndW3cKeysTests.fs" />
        <Compile Include="UnicodeAndControlTests.fs" />
        <Compile Include="DeadKeysAndDigraphsTests.fs" />
        <Compile Include="KeyChordTests.fs" />
        <Compile Include="KeyboardEventTests.fs" />
        <Compile Include="Main.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" Version="11.0.0-alpha8" />
        <PackageReference Include="Expecto.FsCheck" Version="11.0.0-alpha8-fscheck2" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.15.5" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Ranvier.Keyboard\Ranvier.Keyboard.fsproj" />
        <ProjectReference Include="..\..\src\Ranvier.Keyboard.Dom\Ranvier.Keyboard.Dom.fsproj" />
    </ItemGroup>
</Project>
